+    // Tonkori patch: clip gain line, linear in dB between points.
+    if (gainEnvelope != nullptr && ! gainEnvelope->points.empty())
+    {
+        const auto& pts = gainEnvelope->points;
+        const auto numFrames = (int) destAudioBlock.getNumFrames();
+        if ((int) envelopeGains.size() < numFrames) envelopeGains.resize ((size_t) numFrames);
+
+        const double t0 = (editTimeRange.getStart() - (contentZero + dynamicOffset)).inSeconds();
+        const double dt = editTimeRange.getLength().inSeconds() / juce::jmax (1, numFrames);
+        size_t seg = 0;
+
+        auto dbOf = [] (float g) { return g > 1.0e-8f ? 20.0 * std::log10 ((double) g) : -160.0; };
+
+        for (int i = 0; i < numFrames; ++i)
+        {
+            const double t = t0 + dt * i;
+            float g;
+            if (t <= pts.front().first)      g = pts.front().second;
+            else if (t >= pts.back().first)  g = pts.back().second;
+            else
+            {
+                while (seg + 1 < pts.size() && pts[seg + 1].first <= t) ++seg;
+                while (seg > 0 && pts[seg].first > t) --seg;
+                const auto& a = pts[seg];
+                const auto& b = pts[std::min (seg + 1, pts.size() - 1)];
+                const double span = b.first - a.first;
+                const double f = span > 0 ? (t - a.first) / span : 0.0;
+                const double db = dbOf (a.second) + (dbOf (b.second) - dbOf (a.second)) * f;
+                g = db <= -159.0 ? 0.0f : (float) std::pow (10.0, db / 20.0);
+            }
+            envelopeGains[(size_t) i] = g;
+        }
+
+        for (choc::buffer::ChannelCount ch = 0; ch < destAudioBlock.getNumChannels(); ++ch)
+        {
+            auto* d = destAudioBlock.getChannel (ch).data.data;
+            for (int i = 0; i < numFrames; ++i)
+                d[i] *= envelopeGains[(size_t) i];
+        }
+    }
