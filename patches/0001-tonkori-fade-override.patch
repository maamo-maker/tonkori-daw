+    // Tonkori patch: apply a gain table across [startAlpha, endAlpha] (same alpha stepping as AudioFadeCurve::renderBlock).
+    inline void applyCurveTable (juce::AudioBuffer<float>& buffer, int startSample, int numSamples,
+                                 const std::vector<float>& table, float startAlpha, float endAlpha)
+    {
+        if (numSamples <= 0 || table.size() < 2) return;
+
+        const auto last = (double) (table.size() - 1);
+        const double delta = ((double) endAlpha - (double) startAlpha) / numSamples;
+
+        for (int ch = 0; ch < buffer.getNumChannels(); ++ch)
+        {
+            auto* d = buffer.getWritePointer (ch, startSample);
+            double alpha = startAlpha;
+
+            for (int i = 0; i < numSamples; ++i)
+            {
+                const double pos = juce::jlimit (0.0, last, alpha * last);
+                const auto i0 = (size_t) pos;
+                const auto i1 = std::min (i0 + 1, table.size() - 1);
+                const auto frac = (float) (pos - (double) i0);
+                d[i] *= table[i0] + (table[i1] - table[i0]) * frac;
+                alpha += delta;
+            }
+        }
+    }
